{
  "name": "neko-ts",
  "version": "1.0.0",
  "description": "A modern, modular TypeScript scraper for NekoPoi.",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "keywords": [
    "scraper",
    "nekopoi",
    "downloader",
    "api",
    "hentai",
    "typescript",
    "modular"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && tsconfig-to-dual-package",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run lint:fix && npm run build",
    "test": "tsx test/index.ts"
  },
  "author": "SlavyanDesu",
  "license": "MIT",
  "homepage": "https://github.com/SlavyanDesu/neko-ts#readme",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SlavyanDesu/neko-ts.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/cheerio": "^0.22.31",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "rimraf": "^4.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "tsconfig-to-dual-package": "^1.1.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  }
}